  "_meta": {
    "version": "2.4",
    "last_updated": "2026-05-26",
    "reviewed_by": "GeoWorld Academic Review",
    "description": "GeoWorld Framework parameter database. Added cf_ceiling and cf_floor per technology (T6_15). penetration_factor = renewable share TARGET of total national grid (fraction [0-1]). existing_renewable_share = current stat from IEA/IRENA. grid_total_gwh = total national generation baseline (GWh/yr).",
    "changelog": [
      "v2.4: Added cf_ceiling and cf_floor to all technologies (solar, wind, biomass) for all countries. Replaced hardcoded values in lcoe_calculator.py (T6_15).",
      "v2.3: penetration_factor redefined as renewable target share of total grid matrix. Added existing_renewable_share and grid_total_gwh per country.",
      "v2.2: Full academic review. Adjustments in carbon_price, capacity_factor, lifecycle EF.",
      "v2.1: Added hierarchical fallback logic and unit normalization."
    ],
    "units": {
      "cf_ceiling": "Maximum physically plausible capacity factor [0-1] for the technology in the given geography.",
      "cf_floor": "Minimum economically viable capacity factor [0-1] below which deployment is unfeasible.",
      "capacity_factor": "Expected average capacity factor [0-1] for economic modeling."
    }
  },

