# Environment and configuration
.env
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Large raster files (TIF)
*.tif
*.TIF
**/*.tif
**/*.TIF
outputs/**/*.tif

# Temporary files
temp/
configs/~$*.xlsx

# Sensitivity & Config Migration Campaign cross-session commit lock
# (docs/BACKLOG.md) -- transient, removed after each commit; ignored as
# a backstop in case a release step is ever missed.
.session-lock

# Local baseline snapshots for regression diffing
outputs_baseline/

# Output directories - selective
# outputs/???/ matches any ISO-3166-alpha-3 country output directory
# (all country codes are exactly 3 letters), generalized from the
# previous PRT/EGY-only literals so newly added countries are covered.
outputs/logs/
outputs/???/
outputs/*/logs/
outputs/*/*.log
outputs/*/*.jsonl

# Data directories
data/
data/raw/
data/processed/
data/cache/
